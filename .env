# =============================================================================
# Intelligent Incident Agent — backend environment
# Copy to `.env` and fill in. Anything not set falls back to a safe default.
# =============================================================================

# ---- Application ------------------------------------------------------------
APP_NAME="Intelligent Incident Agent"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3020
DEBUG=true
FRONTEND_URL=http://localhost:5173
APP_PUBLIC_BASE_URL=http://187.127.163.17:3001

# ---- Security ---------------------------------------------------------------
JWT_SECRET=change-me-in-production-min-32-chars-long-please
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=14

# ---- Database ---------------------------------------------------------------
DB_HOST=72.61.226.68
DB_PORT=3306
DB_USER=aiinhome
DB_PASSWORD=Aiin@2026
DB_NAME=incident_agent
DB_POOL_SIZE=10

# ---- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Agent behaviour --------------------------------------------------------
AGENT_AUTO_REMEDIATION_THRESHOLD=0.85
AGENT_ESCALATION_TIMEOUT_MINUTES=15
AGENT_KB_AUTO_PUBLISH=false

# ---- Webhooks ---------------------------------------------------------------
# For local dev with ngrok this is the public ngrok URL.
WEBHOOK_PUBLIC_BASE_URL=https://122.163.121.176:3019

# ===== LLM (Mistral Cloud / Local) =====
MISTRAL_MODE=Cloud
MISTRAL_API_KEY=IotlgX9OC7gWRj0WqHuT5xdhT1LNkNne
MODEL_NAME=mistral-small-latest
MISTRAL_LOCAL_URL=http://122.163.121.176:3041
MISTRAL_LOCAL_MODEL=mistral:latest
MISTRAL_ENABLED=true


# =============================================================================
# GraphDB (ArangoDB)
