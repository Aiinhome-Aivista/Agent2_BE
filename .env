# Leave SMTP_HOST blank to disable email entirely; agents will log a skip.
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=aiinhome62@gmail.com
SMTP_PASSWORD=ozhefykfihxxlbas 
SMTP_FROM_ADDRESS=aiinhome62@gmail.com
