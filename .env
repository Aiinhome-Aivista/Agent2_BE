# =============================================================================
# *** NEW *** — Mistral LLM analysis
# Get a key at https://console.mistral.ai/api-keys
# If empty, the LLM analysis agent records a "skipped" step and the pipeline
# continues using only the Knowledge Graph + runbooks.
# ===== LLM (Mistral Cloud / Local) =====
MISTRAL_MODE=Cloud
MISTRAL_API_KEY=IotlgX9OC7gWRj0WqHuT5xdhT1LNkNne
MODEL_NAME=mistral-small-latest
MISTRAL_LOCAL_URL=http://122.163.121.176:3038
MISTRAL_LOCAL_MODEL=mistral:latest
MISTRAL_ENABLED=true

# =============================================================================
