# =============================================================================
# Intelligent Incident Agent — backend environment
# Copy to `.env` and fill in. Anything not set falls back to a safe default.
# =============================================================================

# ---- Application ------------------------------------------------------------
APP_NAME="Intelligent Incident Agent"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=3001
DEBUG=true
FRONTEND_URL=http://localhost:3003
APP_PUBLIC_BASE_URL=https://122.163.121.176:3001

# ---- Security ---------------------------------------------------------------
JWT_SECRET=change-me-in-production-min-32-chars-long-please
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=60
JWT_REFRESH_EXPIRE_DAYS=14

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_MASTER_KEY=8xE7w0AjJCR-5E4iXTb7CEaPI4-SbZNw5OYGl-LVSkA=

# ---- Database ---------------------------------------------------------------
DB_HOST=72.61.226.68
DB_PORT=3306
DB_USER=aiinhome
DB_PASSWORD=Aiin@2026
DB_NAME=incident_agent
DB_POOL_SIZE=10

# ---- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- CORS -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Agent behaviour --------------------------------------------------------
AGENT_AUTO_REMEDIATION_THRESHOLD=0.85
AGENT_ESCALATION_TIMEOUT_MINUTES=15
AGENT_KB_AUTO_PUBLISH=false

# ---- Webhooks ---------------------------------------------------------------
# For local dev with ngrok this is the public ngrok URL.
WEBHOOK_PUBLIC_BASE_URL=https://122.163.121.176:3001

# =============================================================================
# Connectors — OAuth credentials (set per provider as you onboard them)
# =============================================================================


SERVICENOW_OAUTH_CLIENT_ID=
SERVICENOW_OAUTH_CLIENT_SECRET=

SALESFORCE_OAUTH_CLIENT_ID=
SALESFORCE_OAUTH_CLIENT_SECRET=

HUBSPOT_OAUTH_CLIENT_ID=
HUBSPOT_OAUTH_CLIENT_SECRET=

ZOHO_OAUTH_CLIENT_ID=
